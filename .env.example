# Public Firebase client configuration.
# These values are expected to be visible in the mobile app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Public URL for your deployed AI proxy (hosts both Gemini and Groq keys).
# Do not put provider secrets in Expo env vars — they belong on the server.
EXPO_PUBLIC_AI_PROXY_URL=
