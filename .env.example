# Public Firebase client configuration.
# These values are expected to be visible in the mobile app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Public URL for your deployed AI proxy.
# Do not put provider secrets in Expo env vars.
EXPO_PUBLIC_AI_PROXY_URL=

# Groq API key — free cloud fallback for devices without Apple Intelligence.
# Get a free key (no credit card) at: https://console.groq.com
EXPO_PUBLIC_GROQ_API_KEY=
