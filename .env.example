# Public Firebase client configuration.
# These values are expected to be visible in the mobile app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Mobile: separate AI proxy (Fly prod or local backend-proxy on port 3001).
# Web: use built-in Next /api/cue — see web/.env.example (GROQ_API_KEY in web/.env.local).
EXPO_PUBLIC_AI_PROXY_URL=http://localhost:3001/api/cue
