rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // One tree per Firebase user — easy to sync mobile + web against the same prefix:
    //   {uid}/pfp/avatar.jpg
    //   {uid}/notes/{folderSlug}/...
    match /{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // New user-scoped notes path used by web notes uploads:
    //   users/{uid}/notes/{folderId}/{fileName}
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bug report screenshots (primary upload is server-side via Admin SDK).
    //   bugReports/{uid}/{reportId}/{fileName}
    match /bugReports/{uid}/{reportId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
