rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // One tree per Firebase user — easy to sync mobile + web against the same prefix:
    //   {uid}/pfp/avatar.jpg
    //   {uid}/notes/{folderSlug}/...
    match /{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // New user-scoped notes path used by web notes uploads:
    //   users/{uid}/notes/{folderId}/{fileName}
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
