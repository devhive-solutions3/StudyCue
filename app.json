{
  "expo": {
    "name": "StudyCue",
    "slug": "StudyCue",
    "scheme": "studycue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cue-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.StudyCue",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "StudyCue uses your photo library so you can attach images to Cue for study planning context.",
        "NSPhotoLibraryAddUsageDescription": "StudyCue may save selected study images when needed for your planning workflow."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/cue-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.StudyCue"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "StudyCue uses your photo library so you can attach images to Cue for study planning context."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
