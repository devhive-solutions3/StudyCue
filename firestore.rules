rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /classes/{classId} {
        allow read, write: if isOwner(uid);
      }
      match /tasks/{taskId} {
        allow read, write: if isOwner(uid);
      }
      match /taskCategories/{categoryId} {
        allow read, write: if isOwner(uid);
      }
      match /studySessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }
      match /preferences/{prefId} {
        allow read, write: if isOwner(uid) && prefId == 'default';
      }
      match /mirror/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /noteFolders/{folderId} {
        allow read, write: if isOwner(uid);

        match /files/{fileId} {
          allow read, write: if isOwner(uid);
        }
      }
      match /meta/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /quizzes/{quizId} {
        allow read, write: if isOwner(uid);
      }
      match /flashcardDecks/{deckId} {
        allow read, write: if isOwner(uid);
      }
      match /analytics/{dateKey} {
        allow read, write: if false;
      }
      match /usage/{dateKey} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /usageSummary/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /usageRequests/{requestId} {
        allow read, write: if false;
      }
      match /seenAnnouncements/{announcementId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /announcements/{announcementId} {
      allow read, write: if false;
    }
    match /studyToolEvents/{eventId} {
      allow read, write: if false;
    }

    // Bug reports are written by the server (Admin SDK). Lock down direct client access.
    match /bugReports/{reportId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Product analytics — server (Admin SDK) writes only.
    match /analyticsEvents/{eventId} {
      allow read, write: if false;
    }
    match /analyticsDaily/{dateKey} {
      allow read, write: if false;
    }
    match /activeUsersDaily/{dateKey}/users/{uid} {
      allow read, write: if false;
    }
    match /analyticsFeatureDaily/{dateKey}/features/{feature}/users/{uid} {
      allow read, write: if false;
    }
  }
}
